# Copy to .env next to docker-compose.yml and fill in before deploying.

# --- Image version ---
# Which published tag to run for the api / indexer / migrate services. CI
# (.github/workflows/publish.yml) pushes a tag named after the git tag on tag
# pushes, and `nightly` on merges to develop.
#
# Production: pin an explicit release so a redeploy is reproducible.
#   VERSION=2.5.3
# Deploy with:
#   docker compose pull && docker compose up -d --no-build
# VERSION=nightly

# Override only if you publish elsewhere; these reproduce the CI image names
# ghcr.io/pshenmic/platform-explorer-api and ghcr.io/pshenmic/platform-explorer-indexer.
# REGISTRY=ghcr.io
# IMAGE_PREFIX=pshenmic/platform-explorer

# --- Which services to run in compose ---
# postgres and frontend are opt-in. Listing their profiles here means a plain
# `docker compose up -d` does the right thing, with no --profile flags.
#
#   local-db        postgres
#   local-frontend  frontend (skip it when the UI is served from Vercel/CDN etc.)
#   metrics         haproxy-metrics (publishes haproxy's Prometheus exporter)
#
# Always started regardless: migrate, indexer, api, haproxy.
#
# Production: leave this commented out, so only the always-on services start and
# POSTGRES_HOST points at your external database.
COMPOSE_PROFILES=local-db,local-frontend

# --- Database ---
# Required. Used by migrate, indexer and api.
#
# Production (external postgres):
#   POSTGRES_HOST=db.your-host.tld
#
# Local/dev (postgres in compose, `local-db` profile): keep the host as
# `postgres` so it resolves on the compose network. USER/PASS/DB are also used
# to initialise the bundled postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=indexer
POSTGRES_USER=indexer
POSTGRES_PASS=change-me
# Set to any non-empty value to connect to postgres over SSL (api only).
# POSTGRES_SSL=true

# --- Network ---
# mainnet | testnet
NETWORK=testnet

# --- Dash Platform node (Tenderdash, DAPI, Core) ---
# Always external: these come from an evonode / fullnode run with dashmate,
# they cannot be run standalone in this compose stack. For a node on the same
# host as Docker, use host.docker.internal.
#
# Defaults below are dashmate testnet ports.
TENDERDASH_URL=http://host.docker.internal:36657
# Comma-separated list of DAPI endpoints (used by api).
DAPI_URL=https://host.docker.internal:1443

CORE_RPC_HOST=host.docker.internal
CORE_RPC_PORT=19998
CORE_RPC_USER=username
CORE_RPC_PASSWORD=change-me

# --- Indexer ---
# Platform Explorer data contract identifier on the selected network.
PLATFORM_EXPLORER_DATA_CONTRACT_IDENTIFIER=8AoJWLcT4t1uFuWkeTfbeN2EuGuvX2nJsZMVpDsF4ASm
# Optional comma-separated list of state transition hashes to skip.
# TXS_TO_SKIP=

# --- API ---
EPOCH_CHANGE_TIME=3600000
TCP_CONNECT_TIMEOUT=400

# --- Exposed ports ---
# API_PORT is published by haproxy, not by the api containers themselves.
#
# BIND_ADDR is the host interface both published ports bind to. The default
# 127.0.0.1 keeps them reachable only from the machine itself, which is what you
# want when a system haproxy/nginx terminates TLS and proxies to them. Use
# 0.0.0.0 to expose them directly on the network.
BIND_ADDR=127.0.0.1
API_PORT=3005
FRONTEND_PORT=3000
# Only used when the metrics profile is enabled. Scrape
# http://<BIND_ADDR>:<HAPROXY_METRICS_PORT>/metrics.
HAPROXY_METRICS_PORT=8405

# --- Scaling ---
# Number of api containers behind haproxy. Raising this above the
# `server-template api 8` line in the inlined haproxy config (the `configs:`
# block at the bottom of docker-compose.yml) requires raising that too.
API_REPLICAS=4

# --- Frontend build-time config ---
# Must be URLs as reachable from the user's browser, not from inside the
# compose network. Applied at image build time. Other NEXT_PUBLIC_* values
# come from packages/frontend/.env.
NEXT_PUBLIC_API_URL=https://api.your-domain.tld
NEXT_PUBLIC_BASE_URL=https://your-domain.tld
