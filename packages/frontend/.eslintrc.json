{
  "plugins": ["jest"],
  "extends": [
    "eslint-config-standard",
    "next/core-web-vitals"
  ],
  "env": {
    "jest/globals": true
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "rules": {
        "no-unused-vars": "off",
        "no-undef": "off"
      }
    }
  ]
}
