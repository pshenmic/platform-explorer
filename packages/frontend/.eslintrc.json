{
  "plugins": ["jest"],
  "extends": [
    "eslint-config-standard",
    "next/core-web-vitals"
  ],
  "env": {
    "jest/globals": true
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "rules": {
        "no-unused-vars": "off",
        "no-undef": "off",
        "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports", "fixStyle": "separate-type-imports" }]
      }
    }
  ]
}
